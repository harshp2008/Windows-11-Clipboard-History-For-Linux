FROM ubuntu:24.04

# Avoid interactive tzdata prompts
ENV DEBIAN_FRONTEND=noninteractive

WORKDIR /app

# Ensure base installation prerequisites (sudo and curl) are present
RUN apt-get update && apt-get install -y sudo curl && rm -rf /var/lib/apt/lists/*

# Create non-root builder user with passwordless sudo
RUN useradd -m -s /bin/bash builder && \
    echo "builder ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

COPY . .
RUN chown -R builder:builder /app

USER builder
WORKDIR /app

CMD ["/bin/bash", "scripts/install.sh", "--build"]
